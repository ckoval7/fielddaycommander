:8000 {
	root * /app/public
	encode zstd gzip

	# Allow uploads up to 35MB (matches PHP post_max_size)
	request_body {
		max_size 35MB
	}

	# Baseline security headers. "?" only sets a header the app has not set
	# itself, so app middleware stays in charge (framing is left to the app).
	# No HSTS: the container serves plain HTTP; add it at the TLS proxy.
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	route /app/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	php_server
}
