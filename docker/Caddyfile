# Run the app in Octane worker mode. Without this block FrankenPHP boots
# Laravel from scratch on every request. octane:frankenphp sets these
# variables (worker count from --workers, MAX_REQUESTS from --max-requests).
{
	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
		}
	}
}

:8000 {
	root * /app/public
	encode zstd gzip

	# Allow uploads up to 35MB (matches PHP post_max_size)
	request_body {
		max_size 35MB
	}

	# Baseline security headers. "?" only sets a header the app has not set
	# itself, so app middleware stays in charge (framing is left to the app).
	# No HSTS: the container serves plain HTTP; add it at the TLS proxy.
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	route /app/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	php_server {
		index frankenphp-worker.php
		try_files {path} frankenphp-worker.php
		# Required for the public/storage/ symlink
		resolve_root_symlink
	}
}
