# Run the app in Octane worker mode. Without this block FrankenPHP boots
# Laravel from scratch on every request. octane:frankenphp sets these
# variables (worker count from --workers, MAX_REQUESTS from --max-requests).
{
	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
		}
	}
}

{$CADDY_SITE_ADDRESS::80} {
	root * {$APP_PATH:/var/www/fd-commander}/public
	encode zstd gzip

	# Allow uploads up to 35MB (matches PHP post_max_size)
	request_body {
		max_size 35MB
	}

	# Baseline security headers. "?" only sets a header the app has not set
	# itself, so app middleware stays in charge (framing is left to the app).
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Site settings written by deploy.sh/update.sh: TLS certificate or ACME
	# email. Root-owned; an empty directory is fine. HSTS comes from the app
	# (SECURITY_HSTS_MAX_AGE in .env).
	import /etc/frankenphp/caddy.d/*.caddy

	# Reverb WebSocket proxy — route block enforces top-to-bottom ordering
	# so reverse_proxy runs before php_server intercepts /app/* requests.
	route /app/* {
		reverse_proxy {$REVERB_SERVER_HOST:127.0.0.1}:{$REVERB_SERVER_PORT:8080} {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	php_server {
		index frankenphp-worker.php
		try_files {path} frankenphp-worker.php
		# Required for the public/storage/ symlink
		resolve_root_symlink
	}
}
