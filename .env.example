# ---------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------
# APP_NAME is shown in the browser title bar and email notifications.
APP_NAME="Field Day Commander"

# Environment: local, staging, production
APP_ENV=local

# Generated with: php artisan key:generate
APP_KEY=

# Set to false in production to hide detailed error pages.
APP_DEBUG=true

# The base URL for your installation (no trailing slash).
APP_URL=http://localhost

# Host names the app answers to (comma-separated). The APP_URL host, its
# subdomains and local-network addresses are always accepted: localhost,
# private IPs (10.x, 172.16-31.x, 192.168.x), Tailscale/CGNAT IPs
# (100.64-127.x), IPv6 loopback, ULA (fc00::/7) and link-local (fe80::/10)
# addresses, and mDNS names ending in .local. Requests for any other Host get
# an error page so password-reset and invitation links can't be redirected to
# another site. Add every other name or public IP users reach the site by
# (these also open live updates), or "*" to accept any host. Not enforced while
# APP_URL is localhost.
# TRUSTED_HOSTS=fd.example.org,fdcommander.local

# Reverse proxies whose X-Forwarded-* headers (client IP, scheme) are trusted,
# as comma-separated IPs/CIDRs. Defaults to loopback only. Docker defaults to
# Docker's own networks (127.0.0.1,::1,172.16.0.0/12) so a proxy on the same
# host still works; Helm trusts the cluster's ingress ranges. If you put your
# own reverse proxy (for HTTPS) in front of the app, list its address here.
# Don't trust whole LAN ranges: anyone on them could fake their IP.
# TRUSTED_PROXIES=10.0.0.5

# Developer mode enables time travel, database reset tools, etc.
# Forced off when APP_ENV=production unless DEVELOPER_MODE_ALLOW_PRODUCTION=true.
# WARNING: Never enable in production!
DEVELOPER_MODE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Increase for better performance with the built-in PHP server.
# PHP_CLI_SERVER_WORKERS=4

# ---------------------------------------------------------------
# Octane / FrankenPHP (production)
# ---------------------------------------------------------------
# Uncomment these when deploying with Laravel Octane.
# OCTANE_SERVER=frankenphp
# OCTANE_WORKERS=auto
# OCTANE_MAX_REQUESTS=500

# Domain for Caddy/FrankenPHP (used by Caddyfile).
# DOMAIN=localhost

# Application path (used by Caddyfile for document root).
# APP_PATH=/var/www/fd-commander

# ---------------------------------------------------------------
# Password Hashing
# ---------------------------------------------------------------
# Higher values are more secure but slower. 12 is a good default.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
# "stack" combines multiple channels. See config/logging.php.
# "daily" writes one file per day and deletes files older than LOG_DAILY_DAYS,
# so logs cannot fill the disk on small hosts.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Options: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# SQLite is the simplest option — no external server needed.
# For MySQL/PostgreSQL, uncomment and configure the lines below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------
# Session
# ---------------------------------------------------------------
# Driver: file, cookie, database, redis, memcached, array
SESSION_DRIVER=database

# How long (in minutes) before an idle session expires.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Only send the session cookie over HTTPS. Leave unset (or false) for plain-HTTP
# LAN/field deployments; set to true whenever the site is served over TLS.
# SESSION_SECURE_COOKIE=true

# HTTP Strict Transport Security max-age in seconds, sent only over HTTPS.
# Off (0) by default: once a browser sees HSTS it refuses plain HTTP and
# self-signed certificates for that host until it expires, which can lock
# operators out at a field site. Only set it (e.g. 31536000) when the site
# always uses a certificate browsers trust.
# SECURITY_HSTS_MAX_AGE=0

# ---------------------------------------------------------------
# Services
# ---------------------------------------------------------------
# Broadcasting: log (default, no real-time), reverb, pusher, ably
BROADCAST_CONNECTION=log

# Extra hosts allowed to open Reverb WebSocket connections (comma-separated,
# matched against the browser's Origin host; wildcards like *.example.org work).
# Live updates already work from the APP_URL host and its subdomains,
# REVERB_HOST, TRUSTED_HOSTS and every local-network address listed under
# TRUSTED_HOSTS above. Any origin is allowed while APP_URL is localhost.
# REVERB_ALLOWED_ORIGINS=fd.example.org,192.168.1.10

# Browsers open the live-update WebSocket on the same address the page was
# loaded from (Reverb's /app path is proxied there on every install). Only set
# these when Reverb is served from a different public address.
# REVERB_CLIENT_HOST=
# REVERB_CLIENT_PORT=
# REVERB_CLIENT_SCHEME=
FILESYSTEM_DISK=local

# Queue: sync (immediate), database, redis, sqs
QUEUE_CONNECTION=database

# ---------------------------------------------------------------
# Cache
# ---------------------------------------------------------------
# Store: file, database, redis, memcached, array
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ---------------------------------------------------------------
# Redis (only needed if using Redis for cache, queue, or session)
# ---------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------
# Mail
# ---------------------------------------------------------------
# Mailer: smtp, sendmail, mailgun, ses, postmark, log, array
# Use "log" for development — emails appear in storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# AWS (only needed for S3 storage or SES email)
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Vite / Frontend
# ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------

# Two-Factor Authentication: required | optional | disabled
# "required" forces all users to set up 2FA before they can proceed.
# "optional" lets each user decide. "disabled" removes the option entirely.
2FA_MODE=optional

# Registration: open | approval_required | email_verification_required | disabled
# "open" allows anyone to register immediately.
# "approval_required" queues new accounts for admin approval.
# "email_verification_required" sends a verification link first.
# "disabled" closes registration entirely — admins create all accounts.
REGISTRATION_MODE=open

# Password Reset: email | admin_only | hybrid
# "email" sends a reset link. "admin_only" requires an admin to reset.
# "hybrid" allows either method.
PASSWORD_RESET_METHOD=hybrid

# Failed Login: lockout | progressive_delay
# "lockout" locks the account after LOCKOUT_THRESHOLD failures.
# "progressive_delay" adds increasing wait times between attempts.
FAILED_LOGIN_STRATEGY=progressive_delay

# Number of failed attempts before lockout or max delay kicks in.
LOCKOUT_THRESHOLD=5

# Minutes an account stays locked after exceeding the threshold.
LOCKOUT_DURATION=15

# ---------------------------------------------------------------
# Session Timeouts (minutes)
# ---------------------------------------------------------------
# Admin accounts get a shorter timeout for security.
SESSION_TIMEOUT_ADMIN=30

# Regular user timeout (default 240 = 4 hours).
SESSION_TIMEOUT_DEFAULT=240

# When true, sessions stay alive for the duration of a Field Day event
# regardless of the timeout values above.
EVENT_DURATION_MODE=true

# ---------------------------------------------------------------
# Audit Logging
# ---------------------------------------------------------------
# Track login attempts, permission changes, and admin actions.
AUDIT_LOGGING_ENABLED=true

# How many days to keep audit log entries before pruning.
AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------
# Password Requirements
# ---------------------------------------------------------------
# Minimum password length for regular users.
PASSWORD_MIN_LENGTH=8

# Minimum password length for admin accounts (stricter).
PASSWORD_ADMIN_MIN_LENGTH=12

# ---------------------------------------------------------------
# Laravel Sail (local development & testing)
# ---------------------------------------------------------------
# Sail is defined in docker-compose.sail.yml, kept separate from the
# production docker-compose.yml. Point Docker Compose at it by
# uncommenting the line below, then use `vendor/bin/sail up -d`.
# COMPOSE_FILE=docker-compose.sail.yml

# Host UID/GID the container runs as, so files written inside the
# container stay owned by you on the host. Set to `id -u` / `id -g`.
WWWUSER=1000
WWWGROUP=1000

# Host-side ports for the Sail services. Change these if something
# else already listens on the default port.
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

# Xdebug is off by default because it slows the test suite considerably.
# Set to `debug` (or `develop,debug`) when you need to step through code.
SAIL_XDEBUG_MODE=off
